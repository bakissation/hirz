{
  "manifest_version": 3,
  "name": "hirz",
  "version": "0.1.0",
  "description": "Passkeys on Linux: hands WebAuthn requests to the local hirz authenticator.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hirz@hirz.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["page/shim.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["content/relay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
