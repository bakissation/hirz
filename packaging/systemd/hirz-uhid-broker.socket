[Unit]
Description=hirz virtual security key broker socket
Documentation=https://github.com/bakissation/hirz/blob/main/docs/uhid.md

[Socket]
ListenStream=/run/hirz/uhid.sock
# Any local user may connect: the broker checks the peer uid and the udev rule restricts each
# hidraw node to its creator. See docs/uhid.md, "Socket permissions".
SocketMode=0666
SocketUser=root
SocketGroup=root
DirectoryMode=0755
Accept=no
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
