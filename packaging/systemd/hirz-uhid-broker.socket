[Unit]
Description=hirz virtual security key broker socket
Documentation=https://github.com/bakissation/hirz/blob/main/docs/uhid.md

[Socket]
ListenStream=/run/hirz/uhid.sock
# Any local user may connect: the broker admits only uids with an active session on a seat, and
# the udev rule restricts each hidraw node to its creator. On a shared computer use
# SocketGroup=hirz and SocketMode=0660 instead. See docs/uhid.md, "Socket permissions".
SocketMode=0666
SocketUser=root
SocketGroup=root
DirectoryMode=0755
Accept=no
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
