# systemd USER unit for hirzd, the user daemon behind the hirz virtual security key.
# Packages install it to /usr/lib/systemd/user/ and enable it for every user (a user opts out with
# systemctl --user mask --now hirzd). Development: copy it to ~/.config/systemd/user/, then
# systemctl --user daemon-reload && systemctl --user enable --now hirzd.service
[Unit]
Description=hirz virtual security key (user daemon)
Documentation=https://github.com/bakissation/hirz/blob/main/docs/uhid.md
# Approval prompts (zenity) need the session's display and polkit's agent, which exist only in a
# graphical session; the desktop imports the display variables before graphical-session.target.
After=graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target
# The packages enable the unit globally; this keeps it out of login-screen and other system accounts.
ConditionUser=!@system

[Service]
Type=simple
ExecStart=/usr/bin/hirzd
# hirzd retries the broker itself (1 s doubling to 60 s), so it only exits on a fatal error.
Restart=on-failure
RestartSec=5s

# hirzd and its helpers (zenity, pkcheck, fprintd) have no setuid bits or file capabilities, so
# none of the following breaks approval.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# A deny list: the filter also applies to zenity (GTK) and its GPU drivers, whose needs change.
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
# AF_UNIX for the broker, the session bus, Wayland and X11; AF_NETLINK for GLib inside zenity.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
UMask=0077
LimitCORE=0
TasksMax=64
MemoryMax=256M

# Deliberately not set: Protect*=, Private*=, MemoryDenyWriteExecute= and others break zenity or
# imply PrivateUsers=yes, after which hirz-uv refuses every approval (docs/uhid.md, "hirzd user unit").

[Install]
WantedBy=graphical-session.target
