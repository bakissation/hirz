# hirz virtual security key, part 1 of 2 (part 2 is 72-hirz.rules); rationale: docs/uhid.md,
# "hidraw access". ID_SECURITY_TOKEN stays set because snapd reads it, but 70-uaccess.rules would
# turn it into a seat ACL for the wrong user; 72-hirz.rules removes that tag. The broker writes the
# creating uid into HID_PHYS, and the node becomes owned by that uid with mode 0600; ":=" keeps
# later rules from changing it. The file name must sort after 60-fido-id.rules and before
# 70-snap.*.rules.

ACTION=="remove", GOTO="hirz_end"
SUBSYSTEM!="hidraw", GOTO="hirz_end"
# Only nodes of devices created through /dev/uhid with the hirz ids, never real hardware.
DEVPATH!="/devices/virtual/misc/uhid/0003:1209:0007.*", GOTO="hirz_end"
ENV{ID_SECURITY_TOKEN}!="1", GOTO="hirz_end"
IMPORT{parent}="HID_PHYS"
ENV{HID_PHYS}!="[1-9]*", GOTO="hirz_end"

OWNER:="$env{HID_PHYS}", GROUP:="root", MODE:="0600"

# snapd before 2.78 tags only a fixed list of USB ids, which a uhid device never matches, so tag the
# two browser snaps by name; newer snapd adds the same tags itself, and a tag twice changes nothing.
TAG+="snap_firefox_firefox", TAG+="snap_chromium_chromium"

LABEL="hirz_end"
