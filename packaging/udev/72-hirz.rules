# hirz virtual security key, part 2 of 3 (part 1 is 70-hirz.rules, part 3 is 99-zzz-hirz.rules). Removes
# the uaccess tag that 70-uaccess.rules adds to ID_SECURITY_TOKEN nodes, so 73-seat-late.rules gives
# the seat user no ACL. It applies to every uhid device with the hirz ids, also when HID_PHYS is not
# a uid (70-hirz.rules then leaves the node root:root 0600). The file name must sort after
# 70-uaccess.rules and 71-seat.rules and before 73-seat-late.rules.

ACTION=="remove", GOTO="hirz_late_end"
SUBSYSTEM!="hidraw", GOTO="hirz_late_end"
DEVPATH!="/devices/virtual/misc/uhid/0003:1209:0007.*", GOTO="hirz_late_end"

TAG-="uaccess"

LABEL="hirz_late_end"
