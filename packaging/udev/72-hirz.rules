# hirz virtual security key, part 2 of 2 (part 1 is 70-hirz.rules). Removes the uaccess tag that
# 70-uaccess.rules adds to ID_SECURITY_TOKEN nodes, so 73-seat-late.rules gives the seat user no
# ACL. The file name must sort after 70-uaccess.rules and 71-seat.rules and before 73-seat-late.rules.

ACTION=="remove", GOTO="hirz_late_end"
SUBSYSTEM!="hidraw", GOTO="hirz_late_end"
DEVPATH!="/devices/virtual/misc/uhid/0003:1209:0007.*", GOTO="hirz_late_end"
# HID_PHYS was imported from the parent device by 70-hirz.rules.
ENV{HID_PHYS}!="[1-9]*", GOTO="hirz_late_end"

TAG-="uaccess"

LABEL="hirz_late_end"
