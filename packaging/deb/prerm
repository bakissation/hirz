#!/bin/sh
# hirz prerm. Stops the system broker on removal; upgrades keep it running.
# Per-user hirzd units belong to each user: systemctl --user disable --now hirzd
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
    deb-systemd-invoke stop hirz-uhid-broker.socket hirz-uhid-broker.service >/dev/null || true
fi

exit 0
