#!/bin/sh
# hirz postinst. Safe to run more than once; unit state follows debhelper: the broker socket and
# the hirzd user unit (for every user, globally) are enabled on first install, and an
# administrator's "systemctl disable" or "systemctl --global disable" survives upgrades.
set -e

UNIT=hirz-uhid-broker.socket
USER_UNIT=hirzd.service

# Runs systemctl in the user manager of every logged-in user; failures are ignored.
for_each_user() {
    for dir in /run/user/*; do
        [ -d "$dir" ] || continue
        user=$(getent passwd "${dir##*/}" | cut -d: -f1)
        [ -n "$user" ] || continue
        "$@" "$user" || true
    done
}

restart_hirzd() {
    systemctl --user --machine="$1@.host" try-restart "$USER_UNIT" >/dev/null 2>&1
}

# The unit has Requisite=graphical-session.target, so it only starts in a graphical session. A
# user who masked it, or an administrator who disabled it globally, is skipped.
start_hirzd() {
    systemctl --user --machine="$1@.host" daemon-reload >/dev/null 2>&1 || return 0
    state=$(systemctl --user --machine="$1@.host" is-enabled "$USER_UNIT" 2>/dev/null || true)
    [ "$state" = enabled ] || return 0
    systemctl --user --machine="$1@.host" start --no-block "$USER_UNIT" >/dev/null 2>&1
}

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper unmask "$UNIT" >/dev/null || true
            # was-enabled is true for a unit it has never seen, so a new install enables it.
            if deb-systemd-helper --quiet was-enabled "$UNIT"; then
                deb-systemd-helper enable "$UNIT" >/dev/null || true
            else
                deb-systemd-helper update-state "$UNIT" >/dev/null || true
            fi

            deb-systemd-helper --user unmask "$USER_UNIT" >/dev/null || true
            if deb-systemd-helper --quiet --user was-enabled "$USER_UNIT"; then
                deb-systemd-helper --user enable "$USER_UNIT" >/dev/null || true
            else
                deb-systemd-helper --user update-state "$USER_UNIT" >/dev/null || true
            fi
        fi

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
        fi
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload || true
        fi
        if command -v modprobe >/dev/null 2>&1; then
            modprobe uhid 2>/dev/null || true
        fi

        if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
            if [ -n "$2" ]; then
                deb-systemd-invoke try-restart hirz-uhid-broker.service >/dev/null || true
            fi
            deb-systemd-invoke start "$UNIT" >/dev/null || true
        fi

        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            if [ -n "$2" ]; then
                # A running hirzd keeps the old binary until it restarts, which would leave a
                # security fix unapplied until the next login.
                for_each_user restart_hirzd
                echo "hirz was upgraded. If hirzd still runs the old version, restart it: systemctl --user restart hirzd"
            else
                for_each_user start_hirzd
            fi
        fi
        ;;
esac

if [ "$1" = "configure" ] && [ -z "$2" ]; then
    echo "hirz is installed and starts with every desktop session."
    echo "The first time a site asks for a passkey, hirz opens a setup window."
    echo "To set it up in a terminal instead, run: hirz init"
fi

exit 0
