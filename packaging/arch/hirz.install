# shellcheck shell=bash
# pacman's hooks already reload systemd and udev after files change.

post_install() {
  modprobe uhid 2>/dev/null || true
  cat <<'MSG'
==> hirz: start the virtual security key broker (once, as root):
      systemctl enable --now hirz-uhid-broker.socket
==> hirz: then each user sets up their vault and daemon:
      hirz init
      systemctl --user enable --now hirzd
MSG
}

post_upgrade() {
  # A running broker or daemon keeps the old binary until it restarts.
  systemctl try-restart hirz-uhid-broker.service 2>/dev/null || true
  local dir user
  for dir in /run/user/*; do
    [ -d "$dir" ] || continue
    user=$(getent passwd "${dir##*/}" | cut -d: -f1)
    [ -n "$user" ] || continue
    systemctl --user --machine="$user@.host" try-restart hirzd.service >/dev/null 2>&1 || true
  done
  echo '==> hirz: running programs were restarted; if hirzd still runs the old version: systemctl --user restart hirzd'
}

pre_remove() {
  systemctl disable --now hirz-uhid-broker.socket hirz-uhid-broker.service 2>/dev/null || true
}
