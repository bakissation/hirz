# shellcheck shell=bash
# pacman's hooks reload systemd and udev after the transaction, which is after these functions run.

# Runs a function for every logged-in user's name; failures are ignored.
_hirz_each_user() {
  local dir user
  for dir in /run/user/*; do
    [ -d "$dir" ] || continue
    user=$(getent passwd "${dir##*/}" | cut -d: -f1)
    [ -n "$user" ] || continue
    "$1" "$user" || true
  done
}

# hirzd has Requisite=graphical-session.target, so it starts only in a graphical session. A user
# who masked it is skipped.
_hirz_start_hirzd() {
  systemctl --user --machine="$1@.host" daemon-reload >/dev/null 2>&1 || return 0
  [ "$(systemctl --user --machine="$1@.host" is-enabled hirzd.service 2>/dev/null)" = enabled ] || return 0
  systemctl --user --machine="$1@.host" start --no-block hirzd.service >/dev/null 2>&1
}

_hirz_restart_hirzd() {
  systemctl --user --machine="$1@.host" try-restart hirzd.service >/dev/null 2>&1
}

_hirz_stop_hirzd() {
  systemctl --user --machine="$1@.host" stop hirzd.service >/dev/null 2>&1
}

post_install() {
  modprobe uhid 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable --now hirz-uhid-broker.socket 2>/dev/null || true
  systemctl --global enable hirzd.service 2>/dev/null || true
  _hirz_each_user _hirz_start_hirzd
  cat <<'MSG'
==> hirz: the broker and, for every user, hirzd are enabled. The first time a site asks for a
==> hirz: passkey, hirz opens a setup window. To set it up in a terminal instead, run: hirz init
MSG
}

post_upgrade() {
  # A running broker or daemon keeps the old binary until it restarts.
  systemctl try-restart hirz-uhid-broker.service 2>/dev/null || true
  _hirz_each_user _hirz_restart_hirzd
  echo '==> hirz: running programs were restarted; if hirzd still runs the old version: systemctl --user restart hirzd'
}

pre_remove() {
  _hirz_each_user _hirz_stop_hirzd
  systemctl --global disable hirzd.service 2>/dev/null || true
  systemctl disable --now hirz-uhid-broker.socket hirz-uhid-broker.service 2>/dev/null || true
}
