#!/usr/bin/make -f
# Builds hirz offline from the release source tarball plus the vendored crates, which the
# source package carries as the "vendor" component tarball (hirz_VERSION.orig-vendor.tar.xz).
# The compiler is the distribution's: rust-toolchain.toml only matters to rustup, which build
# machines do not use. See docs/release.md for how the PPA upload is assembled.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

# Ubuntu releases whose default rustc is older than the workspace's rust-version ship newer
# compilers as versioned packages (rustc-1.NN under /usr/lib/rust-1.NN/bin). Prefer one when
# the build dependencies installed it.
RUST_BIN := $(lastword $(sort $(wildcard /usr/lib/rust-1.*/bin)))
ifneq ($(RUST_BIN),)
export PATH := $(RUST_BIN):$(PATH)
endif

export CARGO_HOME := $(CURDIR)/debian/cargo-home
export CARGO_INCREMENTAL := 0
export CARGO_NET_OFFLINE := true
export CARGO_PROFILE_RELEASE_STRIP := symbols
export RUSTFLAGS := --remap-path-prefix=$(CURDIR)=/build/hirz

PKGS := -p hirz-cli -p hirzd -p hirz-nmh -p hirz-uhid-broker
DEST := $(CURDIR)/debian/hirz
NMH := /usr/lib/hirz/hirz-nmh
BROKER := /usr/libexec/hirz/hirz-uhid-broker

%:
	dh $@

override_dh_auto_configure:
	ls vendor/*/.cargo-checksum.json >/dev/null 2>&1 || { echo "vendor/ is missing: unpack the orig-vendor tarball" >&2; exit 1; }
	mkdir -p .cargo
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' > .cargo/config.toml

override_dh_auto_build:
	cargo --version
	rustc --version
	cargo build --release --offline --frozen $(PKGS)

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --offline --frozen --workspace
endif

override_dh_auto_install:
	install -Dm0755 target/release/hirz $(DEST)/usr/bin/hirz
	install -Dm0755 target/release/hirzd $(DEST)/usr/bin/hirzd
	install -Dm0755 target/release/hirz-nmh $(DEST)$(NMH)
	install -Dm0755 target/release/hirz-uhid-broker $(DEST)$(BROKER)
	install -d $(DEST)/usr/lib/systemd/system $(DEST)/usr/lib/systemd/user
	sed -E 's#^ExecStart=[^ ]*/hirz-uhid-broker( |$$)#ExecStart=$(BROKER)\1#' \
	  packaging/systemd/hirz-uhid-broker.service > $(DEST)/usr/lib/systemd/system/hirz-uhid-broker.service
	grep -qx 'ExecStart=$(BROKER)' $(DEST)/usr/lib/systemd/system/hirz-uhid-broker.service
	install -m0644 packaging/systemd/hirz-uhid-broker.socket $(DEST)/usr/lib/systemd/system/
	sed -E 's#^ExecStart=[^ ]*/hirzd( |$$)#ExecStart=/usr/bin/hirzd\1#' \
	  packaging/systemd/hirzd.service > $(DEST)/usr/lib/systemd/user/hirzd.service
	grep -Eq '^ExecStart=/usr/bin/hirzd( |$$)' $(DEST)/usr/lib/systemd/user/hirzd.service
	install -Dm0644 -t $(DEST)/usr/lib/udev/rules.d packaging/udev/70-hirz.rules packaging/udev/72-hirz.rules
	install -Dm0644 packaging/polkit/dev.hirz.authenticate.policy \
	  $(DEST)/usr/share/polkit-1/actions/dev.hirz.authenticate.policy
	install -Dm0644 assets/brand/hirz-app-icon.svg $(DEST)/usr/share/icons/hicolor/scalable/apps/hirz.svg
	install -Dm0644 assets/brand/app-icon-256.png $(DEST)/usr/share/icons/hicolor/256x256/apps/hirz.png
	install -d $(DEST)/usr/lib/modules-load.d
	echo uhid > $(DEST)/usr/lib/modules-load.d/hirz.conf
	install -d $(DEST)/usr/lib/mozilla/native-messaging-hosts
	sed 's#@HIRZ_NMH_PATH@#$(NMH)#' packaging/native-messaging/hirz.json \
	  > $(DEST)/usr/lib/mozilla/native-messaging-hosts/hirz.json
	grep -q '"path": "$(NMH)"' $(DEST)/usr/lib/mozilla/native-messaging-hosts/hirz.json
	install -Dm0644 -t $(DEST)/usr/share/doc/hirz README.md SECURITY.md docs/install.md

# The broker socket is handled by the maintainer scripts shared with scripts/package-deb.sh
# (packaging/deb/), which do what dh_installsystemd would. The user unit is never enabled by
# the package: each user runs "systemctl --user enable --now hirzd".
override_dh_installsystemd:

override_dh_installsystemduser:

override_dh_installdeb:
	install -m0755 packaging/deb/postinst debian/hirz.postinst
	install -m0755 packaging/deb/prerm debian/hirz.prerm
	install -m0755 packaging/deb/postrm debian/hirz.postrm
	dh_installdeb

# dh_clean deletes *.orig files everywhere, which would remove the Cargo.toml.orig files
# that the vendored crates' checksums cover.
override_dh_clean:
	dh_clean -XCargo.toml.orig -Xvendor/

override_dh_auto_clean:
	rm -rf target .cargo debian/cargo-home
	rm -f debian/hirz.postinst debian/hirz.prerm debian/hirz.postrm
